# systemd unit for the Atlas autonomous factor-evolution daemon.
#
# Install:
#   sudo cp deploy/atlas-evolution.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now atlas-evolution
#   sudo systemctl status atlas-evolution
#
# This is a template: replace <user> and the project path before installing.
# Tip: `%h` expands to that user's home directory in systemd units.

[Unit]
Description=Atlas factor self-evolution daemon (autonomous learning)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<user>
WorkingDirectory=%h/Atlas-MultiAsset-Advisor
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env python3 scripts/evolution_daemon.py --interval-hours 6
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
